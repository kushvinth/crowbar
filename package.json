  },
  "homepage": "https://github.com/kushvinth/crowbar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kushvinth/crowbar.git"
  },
  "bugs": {
    "url": "https://github.com/kushvinth/crowbar/issues"
  },
  "bin": {
